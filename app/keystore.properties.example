# Plantilla de keystore para builds firmados
# NO incluya credenciales reales en este archivo.
# Copie este archivo a app/keystore.properties y rellene los valores en su máquina local.
# Rutas relativas recomendadas: la keystore se colocará en la carpeta /keystore/release.keystore

# Ruta al archivo de keystore (relativa al directorio raíz del proyecto o al módulo app)
storeFile=keystore/release.keystore

# Contraseña del almacén (store password) - DEJA VACÍO EN ESTE EJEMPLO
storePassword=

# Alias de la clave dentro del keystore
keyAlias=release

# Contraseña de la clave (key password) - DEJA VACÍO EN ESTE EJEMPLO
keyPassword=

# Opcional: si usas un path absoluto en tu máquina, reemplázalo en tu copia local
# Ejemplo (no lo pongas aquí en el repo):
# storeFile=C:\Users\caxul\AndroidStudioProjects\Laboratoriodeldolor\keystore\release.keystore
